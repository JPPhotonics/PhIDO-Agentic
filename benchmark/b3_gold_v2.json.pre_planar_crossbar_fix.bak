{
 "_meta": {
  "title": "B3 gold v2 (12 L3 + 12 L4, paper Table-1 axis; L1/L2 dropped)",
  "status": "DRAFT (in-house, generator-authored) \u2014 auto-built by gold_gen.py",
  "purpose": "Ground-truth circuit topologies for scoring schematic-generation (p300) output, INDEPENDENT of the pipeline. Replaces topology_eval.py's default gold, which is the pipeline's own 4_SG.txt tutorial output on the same 4 prompts (scoring pipeline-vs-self = contamination).",
  "independence": "Every topology below was authored from the prompt's circuit semantics + photonics domain knowledge, NOT copied from any pipeline run. No 4_SG.txt / DSL / CS artifact was consulted for the WIRING. Only the shared PDK vocabulary (component classes + port conventions) is reused \u2014 that is the common ontology both arms target, not a pipeline decision.",
  "what_it_measures": "TOPOLOGY correctness only: 'did the schematic wire the right KINDS of components together, with the right connectivity?' Scored node-id-agnostic (typed-edge multiset F1 + component-class F1 + approx_ged, via topology_eval.score_topology). Component SELECTION (which exact cell, e.g. mzi_2x2_pn_diode vs mzi_2x2_heater_tin_cband) is deliberately NOT penalized here \u2014 that is A5/B2's job. Both gold and prediction are normalized to component CLASSES (function+arity) via class_map before comparison.",
  "ambiguity_policy": "Each entry carries topology_certain. Prompts that fix the wiring uniquely are true. Prompts that leave the inter-component connection COUNT open (e.g. 'a DC connected to a 2x2 MMI' \u2014 one link or a full 2-link cascade?) are false, given a documented canonical reading in 'ambiguity'; these need explicit domain sign-off and may be excluded from the headline F1 or scored with an acceptance band.",
  "accept": "Where more than one component class is functionally correct for a node (e.g. a passive 1x2 power splitter may be an MMI_1x2 or a directional-coupler split), the node lists alternates in 'accept'; the scorer treats any listed class as a typed match for that node.",
  "port_conventions": {
   "1x1 (STRAIGHT, BEND, RING_1bus, HEATER, MZI_1x1, MOD_1x1, PD)": "o1 = left/input, o2 = right/output",
   "GC (grating coupler, 1x0)": "o1 = the single on-chip optical port (the other face couples to fiber/free-space)",
   "1x2 (MMI_1x2, MZI_1x2, PSR, splitters)": "o1 = single/common side (input), o2 & o3 = split side (outputs)",
   "2x2 (DC_2x2, MMI_2x2, MZI_2x2, coupler_ring)": "o1,o2 = left/input side, o3,o4 = right/output side",
   "RING_2bus (add-drop microring, 2x2)": "o1 = in (top bus), o2 = through (top bus), o3 = drop (bottom bus), o4 = add (bottom bus)",
   "WDM (wdm_mzi1x4, 1x4)": "o1 = common/single side, o2..o5 = the four wavelength channels"
  },
  "class_map": {
   "straight": "STRAIGHT",
   "bend_euler": "BEND",
   "_bend_s": "BEND",
   "_bezier_curve": "BEND",
   "_gc": "GC",
